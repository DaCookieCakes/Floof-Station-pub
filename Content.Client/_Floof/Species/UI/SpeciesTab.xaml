<BoxContainer xmlns="https://spacestation14.io"
              xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
              Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True"
              SeparationOverride="10" Margin="10">
    <!-- Guidebook entry -->
    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" SizeFlagsStretchRatio="3"
                     HScrollEnabled="False">
        <BoxContainer Name="GuideContainer" Orientation="Vertical" HorizontalExpand="True" Margin="0 0 10 0" />
    </ScrollContainer>
    <controls:Separator StyleClasses="LowDivider" Orientation="Vertical" />
    <!-- Species preview, selector and overview -->
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SizeFlagsStretchRatio="2">
        <SpriteView Name="Preview" Scale="6 6" SetSize="384 192" Stretch="None" OverrideDirection="South" HorizontalAlignment="Center" />
        <OptionButton Name="SpeciesSelector" HorizontalExpand="True" Margin="0 5" />
        <controls:Separator StyleClasses="LowDivider" Margin="0 5" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <RichTextLabel Name="OverviewLabel" HorizontalExpand="True" VerticalAlignment="Top" />
        </ScrollContainer>
    </BoxContainer>
</BoxContainer>
