cmd-livecharsave-desc = Saves a player's in-round body as their live character.
cmd-livecharsave-help = Usage: livecharsave [player]
cmd-livecharsave-arg-player = [player]
cmd-livecharsave-no-body = {$player} is not in the body of one of their characters.
cmd-livecharsave-failed = Could not save the live character of {$player} in slot {$slot}.
cmd-livecharsave-saved = Saved the live character of {$player} in slot {$slot}.
